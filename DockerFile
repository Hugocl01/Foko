# 1. Partimos de PHP con CLI y extensiones para Laravel
FROM php:8.1-cli

# 2. Instalamos dependencias de sistema (Laravel y Node)
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev zip curl \
  && docker-php-ext-install pdo_mysql zip \
  # Instalamos Node.js (para Vite/React) y Bun si lo usas
  && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
  && apt-get install -y nodejs \
  && npm install -g bun

# 3. Instalamos Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# 4. Directorio de trabajo
WORKDIR /app

# 5. Copiamos todo el proyecto
COPY . .

# 6. Backend: instalamos deps de Laravel y generamos APP_KEY
RUN composer install --no-dev --optimize-autoloader \
  && php artisan key:generate

# 7. Frontend: instalamos deps de JS y generamos los assets con Vite
RUN npm install \
  && npm run build

# 8. Exponemos el puerto donde Laravel servirá la app
EXPOSE 1000

# 9. Comando por defecto al arrancar el contenedor
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=1000"]
